{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowUnreachableCode": false,
    "forceConsistentCasingInFileNames": true,
    "module": "CommonJS",
    "strict": true,
    "target": "ES2022",
    "sourceMap": true,
    "allowJs": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
